{
  "uid": "nvo-platform",
  "title": "Observatory \u2014 Platform Health",
  "description": "Self-observability: API latency and errors, dependency health, telemetry ingestion, agent and WebSocket activity.",
  "tags": [
    "nvidia",
    "observatory",
    "platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "API request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "nvo:api_request_rate:5m",
          "legendFormat": "requests/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "API error ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
