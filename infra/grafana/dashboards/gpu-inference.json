{
  "uid": "nvo-gpu",
  "title": "Observatory \u2014 GPU & Inference",
  "description": "Observed GPU telemetry and inference performance. Panels are filtered by data source so demo telemetry is never mixed with production.",
  "tags": [
    "nvidia",
    "observatory",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "data_source",
        "label": "Data source",
        "type": "custom",
        "query": "production,demo",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production",
            "selected": true
          },
          {
            "text": "demo",
            "value": "demo",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU utilisation",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "nvo_gpu_utilization_percent{data_source=\"$data_source\"}",
          "legendFormat": "GPU {{gpu_index}} {{gpu_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "GPU memory used",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "nvo_gpu_memory_used_megabytes{data_source=\"$data_source\"}",
          "legendFormat": "GPU {{gpu_index}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "GPU temperature",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "nvo_gpu_temperature_celsius{data_source=\"$data_source\"}",
          "legendFormat": "GPU {{gpu_index}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "GPU power draw",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "nvo_gpu_power_watts{data_source=\"$data_source\"}",
          "legendFormat": "GPU {{gpu_index}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Inference request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(nvo_inference_requests_total{data_source=\"$data_source\"}[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Inference latency P95",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nvo_inference_latency_seconds_bucket{data_source=\"$data_source\"}[5m])) by (le, deployment))",
          "legendFormat": "{{deployment}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Token throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(nvo_inference_tokens_total{data_source=\"$data_source\"}[5m])) by (direction)",
          "legendFormat": "{{direction}} tok/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Active alerts by severity",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "nvo_alerts_active",
          "legendFormat": "{{severity}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Alerts fired (1h)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nvo-prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(nvo_alerts_fired_total[1h])) by (condition)",
          "legendFormat": "{{condition}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvo-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 6
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
