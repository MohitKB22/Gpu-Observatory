# Copy to .env (next to docker-compose.yml) and adjust. Every setting has a working default,
# so `docker compose up --build` also runs without this file.
# Local development without Docker needs no .env if you set up the default database (README, "Local development");
# otherwise copy this file to backend/.env and set DATABASE_URL.

# ---------------------------------------------------------------- application
# development | production. Production refuses to start with the default SECRET_KEY.
APP_ENV=development
LOG_LEVEL=INFO
# json (one JSON object per line, for log shippers) or text
LOG_FORMAT=json
# Encrypts endpoint API keys stored in the database. Use 32+ random characters:
#   openssl rand -hex 32
# Keep it stable: changing it makes stored API keys unreadable (re-enter them in the UI).
SECRET_KEY=change-me-in-production
# Browser origins allowed to call the API directly (only needed when the frontend is on another origin).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------- demo mode
# Registers three demo models and seeds labelled sample history. Set to false for production.
DEMO_MODE=true
DEMO_SEED_HISTORY=true
# Demo responses sleep according to a per-model speed profile.
DEMO_SIMULATE_LATENCY=true

# ---------------------------------------------------------------- monitoring
# Background connection checks for enabled models; 0 disables them.
HEALTH_CHECK_INTERVAL_SECONDS=60
HEALTH_CHECK_RETENTION_DAYS=7
SYSTEM_SAMPLE_INTERVAL_SECONDS=5
VLLM_METRICS_TIMEOUT_SECONDS=3
NVIDIA_SMI_PATH=nvidia-smi

# ---------------------------------------------------------------- database
# Used by the bundled PostgreSQL container.
POSTGRES_DB=observatory
POSTGRES_USER=observatory
POSTGRES_PASSWORD=observatory
# Set to use an external PostgreSQL instead (postgres:// and postgresql:// URLs are accepted):
# DATABASE_URL=postgresql://user:password@db.example.com:5432/observatory
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------- server
# 127.0.0.1 keeps the stack private to this machine. Use 0.0.0.0 only behind an authenticating proxy.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=8000
# Each worker runs its own background sampler and health checks; 1 is right for most setups.
WEB_CONCURRENCY=1
